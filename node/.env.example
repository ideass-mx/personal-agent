# Configuración opcional del Node (proceso local).
# filesystem.root — contención de escritura (AGENT_FILESYSTEM_ROOT también vale).

# --- research.search() (dev-only; no onboarding / no UI) ---
# PHASE 60.12 — provider productivo por defecto: electron-duckduckgo
# SEARCH_PROVIDER=electron-duckduckgo
# Idle timeout del runtime Electron (default 5 min = 300000):
# ELECTRON_SERP_IDLE_TIMEOUT_MS=300000
# @deprecated — Electron es el default; ResearchEngine ignora esta bandera:
# ELECTRON_SERP_ENABLED=true
# Histórico / benchmarks (no camino productivo):
# WEBSURFX_BASE_URL=http://127.0.0.1:8081
# LIBREY_BASE_URL=http://127.0.0.1:8082
# SEARCH_TIMEOUT_MS=15000
# SPIKE 60.1-A (optionalDependency agent-search-mcp; sin API keys):
# SEARCH_PROVIDER=agent-search-mcp
# AGENT_SEARCH_ENGINES=duckduckgo,bing,wikipedia,startpage,mojeek
# LOG_LEVEL=silent
