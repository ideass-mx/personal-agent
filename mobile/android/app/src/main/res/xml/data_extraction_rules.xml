<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE 57.11-B: excluir almacenes de identidad/credencial del device del
  cloud backup y de la transferencia de dispositivo.
  La MasterKey de Android Keystore no viaja en backup; restaurar el blob
  cifrado sin ella deja estado inconsistente.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gateway_device_identity.xml" />
        <exclude domain="sharedpref" path="gateway_device_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gateway_device_identity.xml" />
        <exclude domain="sharedpref" path="gateway_device_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
