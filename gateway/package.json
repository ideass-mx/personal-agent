{
  "name": "@mxideass/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Agent Gateway (Agents, Tools/MCP, HTTP/WS, Pairing). Legacy package name was @mxideass/hub.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "research:agent:live": "LOG_LEVEL=silent tsx scripts/research-agent-live.ts",
    "research:agent:live-tools": "LOG_LEVEL=silent tsx scripts/research-agent-live-tools.ts",
    "research:diagnose:61.2.1": "LOG_LEVEL=silent tsx scripts/research-diagnose-61.2.1.ts",
    "research:diagnose:61.2.2": "LOG_LEVEL=silent tsx scripts/research-diagnose-61.2.2.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "hono": "^4.7.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
