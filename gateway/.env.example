# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Token secreto: WS `auth.token` y HTTP Workspace `Authorization: Bearer …`.
# (Nombre histórico HUB_TOKEN: se conserva para no romper .env existentes.)
HUB_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Puerto HTTP/WebSocket del Gateway
HUB_PORT=8787

# Agent Console (PHASE 50): directorio estático opcional (index.html).
# Por defecto el Hub busca web/dist o dist/web relativo al cwd.
# AGENT_CONSOLE_STATIC=/ruta/a/web/dist

# Solo desarrollo Vite (CORS allowlist). Nunca usar * en producción.
# AGENT_CONSOLE_DEV_ORIGIN=http://127.0.0.1:5173

# Opcional pero recomendado para MVP — carpeta que el Local Node puede leer/escribir.
# Sin ella, las tools de filesystem usan comportamiento legacy menos contenido.
# Ejemplo Linux: AGENT_FILESYSTEM_ROOT=/home/tu-usuario/agente-workspace
# AGENT_FILESYSTEM_ROOT=

# --- research.search() (dev-only en el proceso Node; no onboarding / no UI) ---
# Ver node/.env.example — PHASE 60.12 provider default: electron-duckduckgo
# SEARCH_PROVIDER=electron-duckduckgo
# ELECTRON_SERP_IDLE_TIMEOUT_MS=300000
# @deprecated ELECTRON_SERP_ENABLED (ResearchEngine lo ignora)
# Histórico / benchmarks:
# WEBSURFX_BASE_URL=http://127.0.0.1:8081
# LIBREY_BASE_URL=http://127.0.0.1:8082
